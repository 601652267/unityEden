          }
        ],
        "win": [
          {
            "id": 106310611,
            "textId": 106310601,
            "text": "皆様の力になれて嬉しいです。でももっと頼ってもらえたら、もっと嬉しいです。",
            "textCn": "很高兴能为大家提供帮助。但如果你能更加依赖我，我会更高兴。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Win_1"
          }
        ],
        "lose": [
          {
            "id": 107310611,
            "textId": 107310601,
            "text": "わたくしが弱いせいで、こんなことに…すみません…",
            "textCn": "因为我的软弱，所以发生了这样的事情……对不起……",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Fail_1"
          }
        ],
        "homeEntry": [
          {
            "id": 116310601,
            "textId": 116310601,
            "text": "リーダー様、わたくしはここでお仕事ができるでしょうか…？",
            "textCn": "领导，我可以在这里工作吗……？",
            "voicePath": "May_Home_In_1",
            "topPosition": 10
          }
        ],
        "homeTalk": [
          {
            "id": 117310601,
            "textId": 117310601,
            "text": "少しでも世界が平和になるのなら…わたくしは、強くなりたいのです。",
            "textCn": "如果世界能稍微和平一点的话……我想变得更强。",
            "voicePath": "May_Home_Talk_1",
            "topPosition": 10
          },
          {
            "id": 117310602,
            "textId": 117310602,
            "text": "どんなことでも、わたくしにやらせていただけませんか？　わたくしはもっといろんな経験をしなくてはいけませんからっ。",
            "textCn": "你愿意让我做任何事吗？我必须有更多的经历。",
            "voicePath": "May_Home_Talk_2",
            "topPosition": 10
          },
          {
            "id": 117310603,
            "textId": 117310603,
            "text": "ブリジットは今どちらにいるでしょうか？　皆様と仲良くやっているといいのですが…",
            "textCn": "布里奇特现在在哪里？希望大家都好好相处...",
            "voicePath": "May_Home_Talk_3",
            "topPosition": 10
          }
        ]
      }
    }
