          "sort": 110,
          "bubbleId": "14310600:2:447:255,14310601:2:394:261,14310602:2:447:255"
        }
      },
      {
        "id": 18310631,
        "conditionType": 1,
        "conditionValue": 0,
        "detail": {
          "id": 18310631,
          "nameTextId": 95000112,
          "name": "奥義2",
          "nameCn": "必杀语音2",
          "textId": 115310602,
          "text": "皆様の優しさや笑顔は…わたくしが守ります！",
          "textCn": "你的善良和笑容，由我来守护！",
          "voicePath": "May_Battle_C_2",
          "sort": 111,
          "bubbleId": "14310600:2:447:255,14310601:2:394:261,14310602:2:447:255"
        }
      },
      {
        "id": 18310632,
        "conditionType": 1,
        "conditionValue": 0,
        "detail": {
          "id": 18310632,
          "nameTextId": 95000121,
          "name": "戦闘勝利",
          "nameCn": "胜利语音",
          "textId": 106310601,
          "text": "皆様の力になれて嬉しいです。でももっと頼ってもらえたら、もっと嬉しいです。",
          "textCn": "很高兴能为大家提供帮助。但如果你能更加依赖我，我会更高兴。",
          "voicePath": "May_Win_1",
          "sort": 120,
          "bubbleId": "14310600:2:447:255,14310601:2:394:261,14310602:2:447:255"
        }
      },
      {
        "id": 18310633,
        "conditionType": 1,
        "conditionValue": 0,
        "detail": {
          "id": 18310633,
          "nameTextId": 95000131,
          "name": "戦闘失敗",
          "nameCn": "失败语音",
          "textId": 107310601,
          "text": "わたくしが弱いせいで、こんなことに…すみません…",
          "textCn": "因为我的软弱，所以发生了这样的事情……对不起……",
