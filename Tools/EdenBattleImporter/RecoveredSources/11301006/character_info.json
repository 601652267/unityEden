      "unlockQuality": 3,
      "showSpine": "CardShowSpine_11301006",
      "showSpineType": "2",
      "showSpineScale": 1000000,
      "showSpinePosition": "-20:-557:0",
      "showTexture": "img_11301006_2",
      "showTextureScale": 10000,
      "showTexturePosition": "61:-641:0",
      "showTextureSize": "1040:1495",
      "bubbleGroups": {
        "unlock": [
          {
            "id": 101310611,
            "textId": 101310611,
            "text": "わたくしを支えてくださって、ありがとうございます。まだまだ、わたくしは成長しますから…期待していただけると嬉しいです。",
            "textCn": "谢谢你对我的支持。我还在成长……所以如果你能期待的话我会很高兴。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Stage_2"
          }
        ],
        "lottery": [
          {
            "id": 101310601,
            "textId": 101310601,
            "text": "わたくしはメイと申します。この国のため、人類のため、そしてレッドのため…わたくしの力の限り、貢献させていただきます。よろしくお願いいたします。",
            "textCn": "我叫梅。为了这个国家，为了人类，为了红色……我会尽自己最大的努力。感谢您的支持。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "334:259",
            "direction": 1,
            "voicePath": "May_Get_1"
          }
        ],
        "login": [
          {
            "id": 102310602,
            "textId": 102310601,
            "text": "リーダー様、本日のご機嫌はいかがでしょう？　ふふ。",
            "textCn": "尊敬的领导，您今天感觉怎么样？不适用。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_In_1"
          }
        ],
        "idle": [
          {
            "id": 97131061,
            "textId": 97031061,
            "text": "皆様のためなら、わたくしはなんでもしたいと思っているのです。皆様の幸せを見守り、皆様の期待に応えることこそ、わたくしの喜びなのです。",
            "textCn": "我愿意为每个人做任何事。我的快乐在于守护你的幸福并满足你的期望。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Main_1"
          },
          {
            "id": 97131062,
            "textId": 97031062,
            "text": "リーダー様も皆様もとても優しくて…いつも、心があたたかく感じるのです。わたくしもそんな存在になりたいと、心から思います。",
            "textCn": "领导和大家都很友善……心里总感觉很温暖。我真诚地希望自己也能成为这样的人。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Main_2"
          },
          {
            "id": 97131063,
            "textId": 97031063,
            "text": "ブリジットはわたくしの護衛ですが…それ以上に、良き友人だと思っています。リーダー様、どうかブリジット共々よろしくお願いいたします。",
            "textCn": "布丽奇特是我的保镖……但更重要的是，我认为她是一个好朋友。亲爱的领导，请支持我和布丽吉特。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Main_3"
          },
          {
            "id": 97131064,
            "textId": 97031064,
            "text": "皆様と普通の仲間として仲良くなってこそ、 より多くのことが成し遂げられると思うのです。 ですからリーダー様も、 どうかわたくしと仲良くしてくださいね。",
            "textCn": "我相信，和大家成为普通朋友一样，我们可以取得更多的成就。所以，领导，请和我做朋友吧。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Main_4"
          }
        ],
        "levelUp": [
          {
            "id": 103310611,
            "textId": 103310601,
            "text": "これはリーダー様の優しさそのものですね。",
            "textCn": "这就是领导的仁慈。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "394:261",
            "direction": 2,
            "voicePath": "May_Stage_1"
          }
        ],
        "qualityUp": [
          {
            "id": 103310611,
            "textId": 103310601,
            "text": "これはリーダー様の優しさそのものですね。",
            "textCn": "这就是领导的仁慈。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "394:261",
            "direction": 2,
            "voicePath": "May_Stage_1"
          }
        ],
        "starUp": [
          {
            "id": 104310611,
            "textId": 104310601,
            "text": "リーダー様が与えてくださったこの力、必ず皆様のために使いましょう…！",
            "textCn": "让我们利用领袖赋予我们的力量为大家谋福利……！",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "394:261",
            "direction": 2,
            "voicePath": "May_Star_1"
          }
        ],
        "touch": [
          {
            "id": 105310611,
            "textId": 105310601,
            "text": "リーダー様、退屈なのですか？　ふふ。ではわたくしがお付き合いしましょう。おしゃべりでもお買い物でも、なんでも言ってくださいね。",
            "textCn": "领导，你无聊吗？不适用。那么，让我加入你们吧。无论是聊天还是购物，请随时问我任何问题。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Interaction_1"
          },
          {
            "id": 105310612,
            "textId": 105310602,
            "text": "リーダー様は頼もしい方ですね。ブリジットがいないときでも、リーダー様がいるとほっとします。",
            "textCn": "领导是个可靠的人。即使布里奇特不在身边，当领导在的时候我也会感到安心。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Interaction_2"
          },
          {
            "id": 105310613,
            "textId": 105310603,
            "text": "すべてを守れる存在になるためには、もっと強くなって、多くを知らねばなりません。ですから、わたくしをどこへなりとも連れて行ってください、リーダー様！",
            "textCn": "为了成为能够守护一切的人，我必须变得更强，懂得更多。所以，领导，无论你去哪里，都请带上我！",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Interaction_3"
          },
          {
            "id": 105310614,
            "textId": 105310604,
            "text": "リーダー様と同じように辛抱強く、優しく、強く……そして、いつでも皆様を希望で満たす存在になりたいのです。",
            "textCn": "我想像领导者一样耐心、善良、坚强……并且永远让每个人都充满希望。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Interaction_4"
          },
          {
            "id": 105310615,
            "textId": 105310605,
            "text": "わたくしにとって、リーダー様は特別な存在です。わたくしを救い、知らない多くを教えてくれた方…いつまでも、この恩は忘れません。ですから、あなたが苦しく思ったときには、わたくしが手を差し伸べます。どうか、その手を迷わず取ってくださいね。",
            "textCn": "对我来说，领导是一个特别的人。这位拯救了我并教会了我许多我不知道的事情的人……我永远不会忘记这份恩情。所以，当你感到苦恼的时候，我会向你伸出援手。请不要犹豫，握住我的手。",
            "expression": "exp_happy",
            "bottomFrame": "Home:HomeWindowTalkPanel",
            "position": "290:269",
            "direction": 1,
            "voicePath": "May_Interaction_5"
          }
        ],
        "arrayUp": [
          {
            "id": 108310601,
            "textId": 108310601,
            "text": "皆様を守ります！",
            "textCn": "我们会保护大家！",
            "voicePath": "May_Go_1"
          }
        ],
        "attack": [
          {
            "id": 111310602,
            "voicePath": "May_Battle_N_2"
          }
        ],
