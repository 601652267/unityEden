      },
      {
        "id": 18310630,
        "conditionType": 1,
        "conditionValue": 0,
        "detail": {
          "id": 18310630,
          "nameTextId": 95000111,
          "name": "奥義1",
          "nameCn": "必杀语音1",
          "textId": 115310601,
          "text": "皆様との約束のため、精いっぱい力を尽くしましょう！",
          "textCn": "让我们竭尽全力兑现与大家的承诺！",
